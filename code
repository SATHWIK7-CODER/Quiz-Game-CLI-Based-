import random
import sys

def run_quiz():
    # Quiz Data: Questions, Options, and Correct Answer index
    questions = [
        {
            "question": "Which programming language is known as the 'language of the web'?",
            "options": ["Python", "C++", "JavaScript", "Java"],
            "answer": 2
        },
        {
            "question": "What does API stand for?",
            "options": [
                "Application Programming Interface",
                "Advanced Program Integration",
                "Automated Protocol instruction",
                "Applied Power Interconnect"
            ],
            "answer": 0
        },
        {
            "question": "Which data structure follows the Last-In-First-Out (LIFO) principle?",
            "options": ["Queue", "Stack", "Linked List", "Tree"],
            "answer": 1
        },
        {
            "question": "What is the time complexity of a binary search algorithm?",
            "options": ["O(n)", "O(n^2)", "O(log n)", "O(1)"],
            "answer": 2
        },
        {
            "question": "Which of these is NOT a reserved keyword in Python?",
            "options": ["yield", "assert", "finally", "include"],
            "answer": 3
        }
    ]

    print("=" * 40)
    print(" Welcome to the Terminal Tech Quiz! ")
    print("=" * 40)
    
    # Shuffle the questions for a unique experience each time
    random.shuffle(questions)
    
    score = 0
    total_questions = len(questions)

    for i, q in enumerate(questions, 1):
        print(f"\nQuestion {i}: {q['question']}")
        for idx, option in enumerate(q['options']):
            print(f"  {idx + 1}. {option}")
        
        try:
            # Handle user input with validation
            choice = int(input("\nYour answer (1-4): ")) - 1
            if choice == q['answer']:
                print("✅ Correct!")
                score += 1
            else:
                correct_text = q['options'][q['answer']]
                print(f"❌ Wrong. The correct answer was: {correct_text}")
        except (ValueError, IndexError):
            # Graceful error handling for invalid inputs
            print("⚠️ Invalid input. Skipping question...")

    # Final Results and scoring logic
    print("\n" + "=" * 40)
    print(f" QUIZ OVER! Your Final Score: {score}/{total_questions}")
    percentage = (score / total_questions) * 100
    print(f" Grade: {percentage}%")
    print("=" * 40)

if __name__ == "__main__":
    try:
        run_quiz()
    except KeyboardInterrupt:
        print("\n\nQuiz exited. See you next time!")
        sys.exit()
